{
  "manifest_version": 3,

  "name": "Njuskalo Price per SQM",
  "version": "0.2.0",
  "description": "Adds Price per SQM information to Njuškalo.hr real estate listings.",

  "icons": {
    "16": "logo.png",
    "48": "logo.png",
   "128": "logo.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.njuskalo.hr/prodaja-kuca*",
        "https://*.njuskalo.hr/prodaja-stanova*",
        "https://*.njuskalo.hr/prodaja-zemljista*"
      ],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}
